# ABETWORKS WORKCRM - Environment Configuration
# Update these values according to your environment

# Application Configuration
PORT=3000
NODE_ENV=production

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=abetworks_workcrm
DB_USER=postgres
DB_PASSWORD=password

# Connection Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000
DB_MAX_USES=750
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Redis Configuration
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-here-make-it-long-and-random
JWT_EXPIRES_IN=24h

# Stripe Configuration (for payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# SMTP Configuration (for email)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=test
SMTP_PASS=test
SMTP_FROM=noreply@abetworks.com

# OpenTelemetry Configuration (for distributed tracing)
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318/v1/traces

# Backup Configuration
BACKUP_RETENTION_DAYS=30
BACKUP_DIRECTORY=./backups
BACKUP_INTERVAL_HOURS=24

# Data Retention Configuration
DATA_RETENTION_PERIOD=30
SOFT_DELETE_ENABLED=true
AUDIT_LOGGING_ENABLED=true

# Encryption Configuration
ENCRYPTION_ENABLED=false
ENCRYPTION_KEY=your-very-long-encryption-key-here-for-testing-only

# Logging Configuration
LOG_LEVEL=info

# S3 Backup Configuration (optional)
S3_BACKUP_BUCKET=your-backup-bucket-name
S3_REGION=us-east-1

# Redis Backup Configuration (optional)
REDIS_DUMP_PATH=/var/lib/redis/dump.rdb

# Rate Limiting Configuration
BACKUP_FREQUENCY_HOURS=24
LOGGING_ENABLED=true

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_RETRIES=3

# Cache Configuration
CACHE_TTL_DEFAULT=300
CACHE_TTL_LONG=3600
CACHE_TTL_SHORT=60

# Security Configuration
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=900000  # 15 minutes in ms
PASSWORD_RESET_TOKEN_EXPIRY=3600000  # 1 hour in ms