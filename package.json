{
  "name": "abetworks-workcrm",
  "version": "1.0.0",
  "description": "ABETWORKS WORKCRM - Multi-tenant CRM SaaS Platform",
  "main": "dist/app.js",
  "scripts": {
    "prestart": "node scripts/check-prerequisites.js",
    "dev": "npm run prestart && nodemon src/app.ts",
    "build": "tsc",
    "start": "npm run prestart && node dist/app.js",
    "start:dev": "npm run build && npm run dev",
    "docker:up": "docker-compose up --build -d",
    "docker:down": "docker-compose down",
    "docker:restart": "docker-compose down && docker-compose up --build -d",
    "start:workers": "npm run prestart && node dist/worker-server.js",
    "dev:workers": "npm run prestart && nodemon src/worker-server.ts",
    "test": "jest",
    "test:unit": "jest src/__tests__/unit",
    "test:integration": "jest src/__tests__/integration",
    "test:coverage": "jest --coverage",
    "migrate": "node ./migrations/run.js",
    "db:setup": "ts-node src/db-setup.ts",
    "test:api": "node test-api.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "docker:build": "docker build -t abetworks-workcrm .",
    "docker:run": "docker run -p 3000:3000 abetworks-workcrm",
    "docker:compose": "docker-compose up",
    "backup:create": "ts-node src/scripts/create-backup.ts",
    "backup:restore": "ts-node src/scripts/restore-backup.ts",
    "health:check": "curl http://localhost:3000/health",
    "migrate:data-preservation": "ts-node run-data-migration.ts",
    "prereqs": "node scripts/check-prerequisites.js"
  },
  "keywords": [
    "crm",
    "saas",
    "multi-tenant",
    "nodejs",
    "typescript"
  ],
  "author": "ABETWORKS",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.69.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.211.0",
    "@opentelemetry/sdk-node": "^0.211.0",
    "@types/pg": "^8.6.6",
    "@types/stripe": "^8.0.416",
    "axios": "^1.13.4",
    "bcryptjs": "^2.4.3",
    "bullmq": "^4.18.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^6.11.2",
    "helmet": "^6.1.5",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^8.5.1",
    "opossum": "^9.0.0",
    "pg": "^8.10.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.3.1",
    "redis": "^5.10.0",
    "stripe": "^20.3.1",
    "uuid": "^9.0.0",
    "winston": "^3.8.2",
    "winston-daily-rotate-file": "^4.7.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/resources": "^2.5.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^18.15.0",
    "@types/nodemailer": "^7.0.9",
    "@types/opossum": "^8.1.9",
    "@types/supertest": "^2.0.12",
    "@types/uuid": "^10.0.0",
    "cross-env": "^10.1.0",
    "jest": "^29.5.0",
    "multer": "^2.0.2",
    "nodemon": "^2.0.22",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0"
  }
}
