# ABETWORKS WORKCRM - Test Environment
# This is a minimal .env for testing purposes

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (will use Docker)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=abetworks_workcrm
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/abetworks_workcrm

# JWT Configuration
JWT_SECRET=very_long_and_secure_jwt_secret_for_testing_purposes_only
REFRESH_JWT_SECRET=very_long_and_secure_refresh_jwt_secret_for_testing

# Redis Configuration (will use Docker)
REDIS_URL=redis://localhost:6379

# Email Configuration (using dummy values for testing)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=test
SMTP_PASS=test
SMTP_FROM=test@abetworks.com

# Stripe Configuration (test keys)
STRIPE_SECRET_KEY=sk_test_abcdefghijklmnopqrstuvwxyz1234567890
STRIPE_WEBHOOK_SECRET=whsec_test1234567890

# Backup Configuration
BACKUP_RETENTION_DAYS=7
BACKUP_DIRECTORY=./backups
BACKUP_INTERVAL_HOURS=24

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Data Preservation
DATA_RETENTION_PERIOD=30
SOFT_DELETE_ENABLED=true
AUDIT_LOGGING_ENABLED=true
ENCRYPTION_ENABLED=false
ENCRYPTION_KEY=dummy_encryption_key_for_testing